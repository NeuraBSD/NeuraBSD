/**
 * @file CoreSeed.qss
 * * DE: Zentrales Stylesheet für das CoreSeed-Hauptfenster. 
 * Definiert das visuelle Layout basierend auf der "Neuronalen Explosion".
 * * EN: Central stylesheet for the CoreSeed main window.
 * Defines the visual layout based on the "Neural Explosion" design.
 * * @section Layout_Dimensions Maße
 * - Header: 1024x80px
 * - Footer: 1024x70px
 * - Sidebar: 200x618px
 * - Content: 824x618px
 * * Copyright (c) 2026, NeuraBSD / Daniel Hilbert (CodeAkrobat)
 * License: BSD 3-Clause
 */

/* * DE: Haupt-Leinwand (1920x1080).
 * EN: Main canvas (1920x1080).
 */
#MainWindow {
background-image: url("../neura-tools/graphics/branding/CoreSeed/wallpaper_explosion.png");
background-position: center;
background-repeat: no-repeat;
background-color: #0a0a0a;
}

/* * DE: Zentrierter Container (1024x768) mit Glow-Effekt.
 * EN: Centered container (1024x768) with glow effect.
 */
#CoreContainer {
background-image: url("../neura-tools/graphics/branding/CoreSeed/frame_glow.png");
min-width: 1024px;
max-width: 1024px;
min-height: 768px;
max-height: 768px;
border: none;
}

/* * DE: Header mit Trident-Logo (80px).
 * EN: Header with Trident logo (80px).
 */
#Header {
background-image: url("../neura-tools/graphics/branding/CoreSeed/header_bg.png");
min-height: 80px;
max-height: 80px;
border: none;
}

/* * DE: Sidebar für die Navigation (200px).
 * EN: Sidebar for navigation (200px).
 */
#Sidebar {
background-image: url("../neura-tools/graphics/branding/CoreSeed/sidebar_bg.png");
min-width: 200px;
max-width: 200px;
border: none;
}

/* * DE: Hauptinhalt (Partitionierung/Optionen).
 * EN: Main content (partitioning/options).
 */
#Content {
background-image: url("../neura-tools/graphics/branding/CoreSeed/content_bg.png");
border: none;
}

/* * DE: Footer mit CoreSeed-Logo und Slogan (70px).
 * EN: Footer with CoreSeed logo and slogan (70px).
 */
#Footer {
background-image: url("../neura-tools/graphics/branding/CoreSeed/footer_bg.png");
min-height: 70px;
max-height: 70px;
border: none;
}

/* * DE: Schrift-Definitionen für Buttons und Labels.
 * EN: Font definitions for buttons and labels.
 */
QLabel, QPushButton {
color: #b0b0b0;
font-family: 'Courier New', Courier, monospace;
}
