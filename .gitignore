# DE: Git-Ausschlussliste für NeuraBSD (Build-Artefakte & Binaries)
# EN: Git ignore list for NeuraBSD (Build artifacts & binaries)

# Binaries & Executables
*.bin
*.exe
CoreSeed.bin

# Qt / Build System
*.o
*.moc
*.moc.cpp
*.qmake.stash
Makefile
.qtc_clangd/

# Doxygen / Documentation
doc/html/
doc/latex/
doxygen_objdb_*.tmp

# OS Specific
.DS_Store
Thumbs.db

# Python Bytecode
__pycache__/
*.pyc
